<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAFC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="14dp" android:background="#FFFFFF">
        <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="✦" android:textSize="24sp" android:textColor="#FFFFFF" android:background="@drawable/avatar_background"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IA Prof" android:textStyle="bold" android:textSize="20sp" android:textColor="#0F172A"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPT-2 local · aucune connexion" android:textSize="13sp" android:textColor="#64748B" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL" android:textSize="11sp" android:textStyle="bold" android:textColor="#15803D" android:background="@drawable/local_badge" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>
    <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="22dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/chat_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aujourd’hui" android:textSize="12sp" android:textColor="#94A3B8" android:layout_gravity="center_horizontal" android:layout_marginBottom="18dp"/>
            <TextView android:id="@+id/welcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bonjour ! Je suis IA Prof. Chaque réponse est générée localement par GPT-2, directement sur ton téléphone. Pose une question pour commencer." android:textSize="16sp" android:lineSpacingExtra="4dp" android:textColor="#1E293B" android:background="@drawable/assistant_bubble" android:padding="15dp" android:layout_marginEnd="36dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:padding="12dp" android:background="#FFFFFF">
        <EditText android:id="@+id/prompt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:maxLines="4" android:hint="Écris un message…" android:inputType="textCapSentences|textMultiLine" android:paddingStart="15dp" android:paddingEnd="15dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/input_background" android:textColor="#0F172A" android:textColorHint="#94A3B8"/>
        <ImageButton android:id="@+id/generate" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Envoyer le message" android:tint="#FFFFFF" android:background="@drawable/send_background"/>
    </LinearLayout>
</LinearLayout>
